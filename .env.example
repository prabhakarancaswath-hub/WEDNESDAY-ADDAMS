# Server-only Vercel environment variables (never expose these in VITE_* variables)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Public Supabase project settings used by the sign-in screen
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Leave blank when the frontend and /api routes share the same Vercel origin
VITE_API_BASE_URL=
